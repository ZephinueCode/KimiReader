{
  "name": "kimireader",
  "version": "2.0.0",
  "description": "从网页版Kimi自动拉取、读取聊天记录，支持总结和代码方案框架生成。基于Playwright浏览器自动化。",
  "config_file": "config.json",
  "tools": [
    {
      "name": "kimi_login_status",
      "description": "检查KimiReader浏览器自动化的登录状态。返回是否已登录、cookies存储位置等信息。",
      "command": ["python3", "scripts/kimireader_browser.py"],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["status"],
            "description": "操作类型"
          }
        },
        "required": ["action"]
      }
    },
    {
      "name": "kimi_login",
      "description": "打开浏览器窗口，让用户在kimi.moonshot.cn手动登录。登录成功后会保存cookie和storage状态，供后续自动拉取使用。支持force参数强制重新登录。",
      "command": ["python3", "scripts/kimireader_browser.py"],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["login"],
            "description": "操作类型"
          },
          "force": {
            "type": "boolean",
            "default": false,
            "description": "是否强制重新登录（即使已有有效状态）"
          },
          "browser_type": {
            "type": "string",
            "enum": ["chromium", "firefox", "webkit"],
            "default": "chromium",
            "description": "浏览器类型"
          }
        },
        "required": ["action"]
      }
    },
    {
      "name": "kimi_logout",
      "description": "清除保存的Kimi登录状态（cookies和storage state）。",
      "command": ["python3", "scripts/kimireader_browser.py"],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["logout"],
            "description": "操作类型"
          }
        },
        "required": ["action"]
      }
    },
    {
      "name": "list_chat_sessions",
      "description": "列出网页版Kimi（kimi.moonshot.cn）上的历史对话列表。需要先完成登录。返回每个会话的session_id、title和url。",
      "command": ["python3", "scripts/kimireader_browser.py"],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list"],
            "description": "操作类型"
          },
          "headless": {
            "type": "boolean",
            "default": true,
            "description": "是否使用无头模式（后台运行，不显示浏览器窗口）"
          }
        },
        "required": ["action"]
      }
    },
    {
      "name": "import_chat_history",
      "description": "从网页版Kimi导入指定对话的完整聊天记录。支持通过index（从list结果中的序号）、session_id或url指定对话。返回结构化消息列表和full_text拼接文本。",
      "command": ["python3", "scripts/kimireader_browser.py"],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["extract"],
            "description": "操作类型"
          },
          "index": {
            "type": "integer",
            "description": "从list_chat_sessions结果中选择的序号（0-based）。如果提供了session_id或url，此参数会被忽略。"
          },
          "session_id": {
            "type": "string",
            "description": "会话ID（如cxxxxxx）。如果不提供，则需要提供index或url。"
          },
          "url": {
            "type": "string",
            "description": "对话的完整URL。如果不提供，则需要提供index或session_id。"
          },
          "headless": {
            "type": "string",
            "default": true,
            "description": "是否使用无头模式"
          }
        },
        "required": ["action"]
      }
    },
    {
      "name": "list_chat_files",
      "description": "（兼容模式）在本地常见目录查找之前导出的Kimi聊天记录文件。",
      "command": ["python3", "scripts/read_chat.py"],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list"],
            "description": "操作类型"
          }
        },
        "required": ["action"]
      }
    },
    {
      "name": "read_chat_file",
      "description": "（兼容模式）读取本地指定的Kimi聊天记录文件（JSON/Markdown格式）。",
      "command": ["python3", "scripts/read_chat.py"],
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["read"],
            "description": "操作类型"
          },
          "file_path": {
            "type": "string",
            "description": "聊天记录文件路径"
          }
        },
        "required": ["action"]
      }
    }
  ]
}
