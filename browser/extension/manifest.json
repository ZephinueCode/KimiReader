{
  "manifest_version": 3,
  "name": "KimiReader - 聊天记录导出",
  "version": "1.0.0",
  "description": "将 kimi.moonshot.cn 的聊天记录导出为JSON，供Kimi Code CLI插件读取",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://kimi.moonshot.cn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://kimi.moonshot.cn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
